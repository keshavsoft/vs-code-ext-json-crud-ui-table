{
  "name": "vs-code-ext-json-crud-ui-table",
  "displayName": "Crud Ui Table Init",
  "description": "Generate Ui for different tables",
  "publisher": "KeshavSoft",
  "type": "module",
  "version": "1.2.2",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keshavsoft/vs-code-ext-json-crud-ui-table.git"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.explorer.context.folder.ui.table.init.showAll",
        "title": "Init ShowAll"
      },
      {
        "command": "extension.explorer.context.folder.ui.table.init.showAllWithSerial",
        "title": "Init ShowAllWithSerial"
      },
      {
        "command": "extension.explorer.context.folder.ui.table.init.withHeader",
        "title": "Init WithHeader"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "extension.explorer.context.folder.ui.table.init.showAll",
          "when": "explorerResourceIsFolder",
          "group": "navigation@2"
        },
        {
          "command": "extension.explorer.context.folder.ui.table.init.showAllWithSerial",
          "when": "explorerResourceIsFolder",
          "group": "navigation@2"
        },
        {
          "command": "extension.explorer.context.folder.ui.table.init.withHeader",
          "when": "explorerResourceIsFolder",
          "group": "navigation@2"
        }
      ],
      "editor/context": [],
      "editor/title": []
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.116.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "dependencies": {
    "json-crud-ui-table": "^1.7.4"
  }
}